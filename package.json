{
  "name": "archi-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "check:content": "tsx scripts/check-content.ts",
    "build": "npm run check:content && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@xyflow/react": "12.3.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@eslint/js": "9.16.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.16.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.13.0",
    "jsdom": "25.0.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.17.0",
    "vite": "5.4.11",
    "vitest": "2.1.8",
    "yaml": "2.6.1"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
